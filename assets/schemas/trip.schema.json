        "description": {
          "type": "string"
        },
        "place_id": {
          "$ref": "#/$defs/nullableString"
        },
        "requires_booking": {
          "type": "boolean"
        },
        "instant": {
          "type": "boolean"
        },
        "cost_delta": {
          "$ref": "#/$defs/nullableString"
        },
        "time_delta": {
          "$ref": "#/$defs/nullableString"
        },
        "verification_status": {
          "enum": [
